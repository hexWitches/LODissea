        replacement_content: "import { useRef } from \'react\';\nimport { motion, useScroll, useTransform } from \'motion/react\';\nimport { Sailboat } from \'lucide-react\';\nimport {\n  LineChart,\n  Line,\n  XAxis,\n  YAxis,\n  CartesianGrid,\n  Tooltip,\n  ResponsiveContainer,\n} from \'recharts\';\n\nconst data = [\n  { name: \'1500\', artifacts: 400 },\n  { name: \'1600\', artifacts: 3000 },\n  { name: \'1700\', artifacts: 2000 },\n  { name: \'1800\', artifacts: 2780 },\n  { name: \'1900\', artifacts: 1890 },\n  { name: \'2000\', artifacts: 2390 },\n];\n\nexport default function AnalysisSection() {\n  const containerRef = useRef(null);\n  const { scrollYProgress } = useScroll({\n    target: containerRef,\n    offset: [\"start start\", \"end end\"]\n  });\n  \n  // Moves boat from top (0%) to bottom (100%) of the viewport height as user scrolls\n  const boatY = useTransform(scrollYProgress, [0, 1], [\"20vh\", \"80vh\"]);\n\n  return (\n    <section ref={containerRef} id=\"analysis\" className=\"relative min-h-[200vh] bg-[#1A3A5F] text-white\">\n      {/* Fixed Progress Bar left side */}\n      <div className=\"sticky top-0 h-screen w-0 pointer-events-none z-50\">\n        <div className=\"absolute left-[55px] top-0 bottom-0 w-[2px] bg-[#3A5A7F] opacity-50\" />\n        <motion.div\n          style={{ y: boatY }}\n          className=\"absolute left-[40px]\"\n        >\n          <motion.div\n            animate={{ y: [0, -5, 0], rotate: [-5, 5, -5] }}\n            transition={{ repeat: Infinity, duration: 3, ease: \"easeInOut\" }}\n          >\n            <Sailboat size={32} strokeWidth={2} className=\"fill-[#FBF9F5] text-[#1A3A5F]\" />\n          </motion.div>\n        </motion.div>\n      </div>\n\n      <div className=\"sticky top-0 h-screen flex items-center justify-center p-8 md:p-24 pl-32\">\n        <div className=\"max-w-5xl w-full grid md:grid-cols-2 gap-16 items-center\">\n          <div>\n            <h2 className=\"text-[40px] md:text-[60px] font-black tracking-tighter mb-6 text-white leading-tight\">\n              Tracing <br/> <span className=\"italic font-light opacity-80\">the artifacts</span>\n            </h2>\n            <p className=\"font-sans text-[13px] uppercase tracking-[0.2em] text-[#7A98B8] mb-8 leading-relaxed\">\n              Analyzing the volume of digital heritage across centuries.\n            </p>\n            <p className=\"text-sm font-sans font-light leading-relaxed opacity-90 text-justify\">\n              Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.\n            </p>\n          </div>\n          \n          <div className=\"h-[400px] w-full\">\n            <ResponsiveContainer width=\"100%\" height=\"100%\">\n              <LineChart data={data} margin={{ top: 5, right: 20, bottom: 5, left: 0 }}>\n                <Line type=\"monotone\" dataKey=\"artifacts\" stroke=\"#6D213C\" strokeWidth={3} dot={{ r: 4, fill: \'#6D213C\' }} />\n                <CartesianGrid stroke=\"#3A5A7F\" strokeDasharray=\"3 3\" vertical={false} />\n                <XAxis dataKey=\"name\" stroke=\"#7A98B8\" tick={{ fill: \'#7A98B8\', fontSize: 12 }} axisLine={false} tickLine={false} />\n                <YAxis stroke=\"#7A98B8\" tick={{ fill: \'#7A98B8\', fontSize: 12 }} axisLine={false} tickLine={false} />\n                <Tooltip \n                  contentStyle={{ backgroundColor: \'#0A1A2F\', border: \'none\', borderRadius: \'4px\', color: \'#fff\' }}\n                  itemStyle={{ color: \'#FBF9F5\' }}\n                />\n              </LineChart>\n            </ResponsiveContainer>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n}"
