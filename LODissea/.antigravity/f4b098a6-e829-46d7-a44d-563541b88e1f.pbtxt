  file_change {
    absolute_path_uri: "file:///src/components/MapJourney.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { useEffect, useState, useMemo } from \'react\';\nimport { motion } from \'motion/react\';\nimport { Sailboat } from \'lucide-react\';\nimport * as d3 from \'d3-geo\';\nimport * as topojson from \'topojson-client\';\n\nconst HIGHLIGHTED_COUNTRIES = [\'Netherlands\', \'Germany\', \'Spain\', \'Portugal\', \'France\', \'Italy\'];\n\nexport default function MapJourney() {\n  const [geographies, setGeographies] = useState<any[]>([]);\n\n  useEffect(() => {\n    fetch(\'https://unpkg.com/world-atlas@2.0.2/countries-50m.json\')\n      .then(response => response.json())\n      .then(topology => {\n        const geo = topojson.feature(topology, topology.objects.countries) as any;\n        setGeographies(geo.features);\n      });\n  }, []);\n\n  // Use a conic conformal projection centered on Europe\n  const projection = useMemo(() => {\n    return d3.geoConicConformal()\n      .center([10, 50])\n      .rotate([-10, 0])\n      .scale(900)\n      .translate([400, 300]);\n  }, []);\n\n  const pathGenerator = d3.geoPath().projection(projection);\n\n  // Position of Netherlands on the SVG\n  // NL coords approx [5.29, 52.13]\n  const nlCoords = projection([5.29, 52.13]) || [0, 0];\n\n  return (\n    <section id=\"journey\" className=\"relative min-h-screen bg-slate-50 overflow-hidden flex items-center justify-center\">\n      <div className=\"absolute inset-0 w-full h-full\">\n        {/* Animated Boat Drop */}\n        <motion.div\n          initial={{ y: -200, opacity: 0, scale: 0.5 }}\n          whileInView={{ y: nlCoords[1] - 40, x: nlCoords[0] - 20, opacity: 1, scale: 1 }}\n          viewport={{ once: true, margin: \"-200px\" }}\n          transition={{ duration: 2, ease: \"easeOut\" }}\n          className=\"absolute z-20 text-blue-600\"\n          style={{ \n            left: 0, // Base coordinates are 0, we translate via framer motion\n            top: 0 \n          }}\n        >\n          <motion.div\n            animate={{ y: [0, -5, 0], rotate: [-5, 5, -5] }}\n            transition={{ repeat: Infinity, duration: 3, ease: \"easeInOut\" }}\n          >\n            <Sailboat size={32} strokeWidth={2} className=\"fill-blue-100\" />\n          </motion.div>\n        </motion.div>\n\n        <svg\n          viewBox=\"0 0 800 600\"\n          className=\"w-full h-full max-h-screen object-contain\"\n        >\n          <g className=\"countries\">\n            {geographies.map((d, i) => {\n              // This is a naive matching since world-atlas names might be inside properties.name\n              // The 50m dataset has properties.name\n              const name = d.properties?.name;\n              const isHighlighted = HIGHLIGHTED_COUNTRIES.includes(name);\n              \n              return (\n                <path\n                  key={`path-${i}`}\n                  d={pathGenerator(d) || undefined}\n                  className={`\n                    transition-colors duration-1000\n                    ${isHighlighted ? \'fill-blue-200 stroke-blue-400 stroke-1\' : \'fill-slate-200 stroke-slate-300 stroke-[0.5px]\'}\n                  `}\n                />\n              );\n            })}\n          </g>\n        </svg>\n      </div>\n      \n      <div className=\"absolute bottom-12 left-12 z-30 pointer-events-none\">\n        <h2 className=\"text-4xl font-serif text-slate-800\">The Journey Begins</h2>\n        <p className=\"text-slate-500 font-light mt-2 max-w-sm\">\n          Starting in the Netherlands, exploring the vast archives of cultural artifacts.\n        </p>\n      </div>\n    </section>\n  );\n}\n"
    }
