    replacement_chunks {
      replacement_content: "import { motion, AnimatePresence } from \'motion/react\';\n\ninterface AboutModalProps {\n  activeTab: string | null;\n  onClose: () => void;\n  onTabChange: (tab: string) => void;\n}\n\nexport default function AboutModal({ activeTab, onClose, onTabChange }: AboutModalProps) {\n  if (!activeTab) return null;\n\n  return (\n    <AnimatePresence>\n      <motion.div\n        initial={{ opacity: 0 }}\n        animate={{ opacity: 1 }}\n        exit={{ opacity: 0 }}\n        className=\"fixed inset-0 z-50 bg-[#1A3A5F] flex flex-col p-12 md:p-24\"\n      >\n        {/* Navigation inside modal */}\n        <nav className=\"absolute top-12 right-12 flex gap-10 font-sans text-[11px] font-bold uppercase tracking-[0.25em] text-[#7A98B8]\">\n          <button \n            onClick={() => onTabChange(\'project\')} \n            className={`border-b pb-1 transition-all ${activeTab === \'project\' ? \'text-white border-white\' : \'border-transparent hover:text-white\'}`}\n          >\n            Project\n          </button>\n          <button \n            onClick={() => onTabChange(\'team\')} \n            className={`border-b pb-1 transition-all ${activeTab === \'team\' ? \'text-white border-white\' : \'border-transparent hover:text-white\'}`}\n          >\n            Team\n          </button>\n          <button \n            onClick={() => onTabChange(\'credit\')} \n            className={`border-b pb-1 transition-all ${activeTab === \'credit\' ? \'text-white border-white\' : \'border-transparent hover:text-white\'}`}\n          >\n            Credit\n          </button>\n          <button onClick={onClose} className=\"ml-8 text-white hover:text-red-400\">\n            CLOSE\n          </button>\n        </nav>\n\n        {/* Content */}\n        <div className=\"flex-1 flex items-center justify-center max-w-4xl mx-auto w-full\">\n          <AnimatePresence mode=\"wait\">\n            {activeTab === \'project\' && (\n              <motion.div\n                key=\"project\"\n                initial={{ opacity: 0, y: 20 }}\n                animate={{ opacity: 1, y: 0 }}\n                exit={{ opacity: 0, y: -20 }}\n                transition={{ duration: 0.5 }}\n                className=\"w-full\"\n              >\n                <h3 className=\"text-[10px] font-sans font-bold uppercase tracking-[0.2em] mb-4 text-[#7A98B8]\">The Project</h3>\n                <p className=\"text-2xl md:text-4xl font-serif leading-relaxed text-white opacity-90\">\n                  LODissea maps the cultural connections across Europe, exploring the vast archives of the Europeana database. \n                  We navigate through digital artifacts, surfacing hidden narratives and shared histories.\n                </p>\n              </motion.div>\n            )}\n\n            {activeTab === \'team\' && (\n              <motion.div\n                key=\"team\"\n                initial={{ opacity: 0, y: 20 }}\n                animate={{ opacity: 1, y: 0 }}\n                exit={{ opacity: 0, y: -20 }}\n                transition={{ duration: 0.5 }}\n                className=\"w-full\"\n              >\n                <h3 className=\"text-[10px] font-sans font-bold uppercase tracking-[0.2em] mb-4 text-[#7A98B8]\">The Team</h3>\n                <div className=\"text-2xl md:text-4xl font-serif leading-relaxed text-white opacity-90 max-w-3xl\">\n                  A multidisciplinary group of researchers, designers, and developers passionate about digital cultural heritage and semantic web technologies.\n                </div>\n              </motion.div>\n            )}\n\n            {activeTab === \'credit\' && (\n              <motion.div\n                key=\"credit\"\n                initial={{ opacity: 0, y: 20 }}\n                animate={{ opacity: 1, y: 0 }}\n                exit={{ opacity: 0, y: -20 }}\n                transition={{ duration: 0.5 }}\n                className=\"w-full\"\n              >\n                <h3 className=\"text-[10px] font-sans font-bold uppercase tracking-[0.2em] mb-4 text-[#7A98B8]\">Credit</h3>\n                <p className=\"text-xl md:text-2xl font-sans font-light leading-relaxed max-w-3xl text-white opacity-70 italic\">\n                  Data sourced from Europeana. All cultural artifacts remain the property of their respective institutions. \n                  This project uses Linked Open Data (LOD) principles to connect and display these resources.\n                </p>\n              </motion.div>\n            )}\n          </AnimatePresence>\n        </div>\n      </motion.div>\n    </AnimatePresence>\n  );\n}\n"
    }
