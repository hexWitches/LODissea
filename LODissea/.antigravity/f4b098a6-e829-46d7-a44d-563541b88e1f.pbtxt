      full: "import { useEffect, useState, useMemo, useRef } from \'react\';import { motion, useInView } from \'motion/react\';import { Sailboat, ArrowDown } from \'lucide-react\';import * as d3 from \'d3-geo\';import * as topojson from \'topojson-client\';const HIGHLIGHTED_COUNTRIES = [\'Netherlands\', \'Germany\', \'Spain\', \'Portugal\', \'France\', \'Italy\'];const OMITTED_COUNTRIES = [  \'Morocco\', \'Algeria\', \'Tunisia\', \'Libya\', \'Egypt\', \'Western Sahara\', \'Mauritania\', \'Mali\', \'Niger\', \'Chad\', \'Sudan\',  \'Syria\', \'Iraq\', \'Saudi Arabia\', \'Lebanon\', \'Israel\', \'Jordan\', \'Iran\', \'Kuwait\', \'Georgia\', \'Armenia\', \'Azerbaijan\'];export default function MapJourney() {  const [geographies, setGeographies] = useState<any[]>([]);  const containerRef = useRef(null);  const isInView = useInView(containerRef, { once: true, margin: \"-20%\" });    const [coloredCount, setColoredCount] = useState(0);  const [boatPhase, setBoatPhase] = useState<\'hidden\' | \'falling\' | \'onMap\' | \'toLeft\'>(\'hidden\');  useEffect(() => {    fetch(\'https://unpkg.com/world-atlas@2.0.2/countries-50m.json\')      .then(response => response.json())      .then(topology => {        const geo = topojson.feature(topology, topology.objects.countries) as any;        setGeographies(geo.features);      });  }, []);  useEffect(() => {    if (isInView) {      setBoatPhase(\'falling\');      const t1 = setTimeout(() => setBoatPhase(\'onMap\'), 1500);            const intervals = HIGHLIGHTED_COUNTRIES.map((_, i) => {        return setTimeout(() => setColoredCount(i + 1), 1500 + i * 500);      });      const t2 = setTimeout(() => setBoatPhase(\'toLeft\'), 1500 + HIGHLIGHTED_COUNTRIES.length * 500 + 500);      return () => {        clearTimeout(t1);        clearTimeout(t2);        intervals.forEach(clearTimeout);      };    }  }, [isInView]);  const projection = useMemo(() => {    return d3.geoConicConformal()      .center([15, 52])      .rotate([-10, 0])      .scale(1600)      .translate([400, 300]);  }, []);  const pathGenerator = d3.geoPath().projection(projection);  const nlCoords = projection([5.29, 52.13]) || [0, 0];  return (    <section ref={containerRef} id=\"journey\" className=\"relative h-screen bg-[#1A3A5F] overflow-hidden flex items-center justify-center pt-24\">      <div className=\"absolute inset-0 w-full h-full flex items-center justify-center\">        <svg          viewBox=\"0 0 800 600\"          className=\"w-full h-full max-h-[90vh] object-contain\"        >          <g className=\"countries\">            {geographies.map((d, i) => {              const name = d.properties?.name;              if (OMITTED_COUNTRIES.includes(name)) return null;              const countryIndex = HIGHLIGHTED_COUNTRIES.indexOf(name);              const isHighlighted = countryIndex !== -1 && countryIndex < coloredCount;                            return (                <path                  key={`path-${i}`}                  d={pathGenerator(d) || undefined}                  className={`                    transition-all duration-500                    ${isHighlighted ? \'fill-[#6D213C] stroke-[#1A3A5F] stroke-[1px] opacity-100\' : \'fill-[#FBF9F5] stroke-[#1A3A5F] stroke-[0.5px] opacity-100\'}                  `}                />              );            })}          </g>          {/* Animated Boat Drop Inside SVG */}          {boatPhase !== \'hidden\' && boatPhase !== \'toLeft\' && (            <motion.g              initial={{ y: -400, opacity: 0, scale: 0.5 }}              animate={{ y: nlCoords[1] - 40, x: nlCoords[0] - 16, opacity: 1, scale: 1 }}              transition={{ duration: 1.5, ease: \"easeOut\" }}            >              <motion.g                animate={{ y: [0, -5, 0], rotate: [-5, 5, -5] }}                transition={{ repeat: Infinity, duration: 3, ease: \"easeInOut\" }}                style={{ transformOrigin: \"16px 32px\" }}              >                <foreignObject x=\"0\" y=\"0\" width=\"32\" height=\"32\">                  <div className=\"w-full h-full flex items-center justify-center\">                    <Sailboat size={32} strokeWidth={2} className=\"fill-[#1A3A5F] text-[#FBF9F5]\" />                  </div>                </foreignObject>              </motion.g>            </motion.g>          )}        </svg>      </div>            {/* Absolute boat that moves to the left of the screen */}      {boatPhase === \'toLeft\' && (        <motion.div          initial={{ top: \'50%\', left: \'50%\', x: \'-50%\', y: \'-50%\', position: \'absolute\' }}          animate={{ left: \'40px\', top: \'80%\', x: 0, y: \'-50%\' }}          transition={{ duration: 1, ease: \'easeInOut\' }}          className=\"absolute z-50 text-[#FBF9F5] flex items-center gap-4 pointer-events-none\"        >          <motion.div            animate={{ y: [0, -5, 0], rotate: [-5, 5, -5] }}            transition={{ repeat: Infinity, duration: 3, ease: \"easeInOut\" }}            className=\"z-10\"          >            <Sailboat size={32} strokeWidth={2} className=\"fill-[#FBF9F5] text-[#1A3A5F]\" />          </motion.div>          <motion.span             initial={{ opacity: 0 }}            animate={{ opacity: 1 }}            transition={{ delay: 0.5 }}            className=\"font-sans text-[10px] font-bold tracking-widest uppercase text-[#7A98B8]\"          >            QQ1          </motion.span>        </motion.div>      )}      {boatPhase === \'toLeft\' && (        <motion.button          initial={{ opacity: 0, y: -20 }}          animate={{ opacity: 1, y: 0 }}          transition={{ delay: 1 }}          onClick={() => document.getElementById(\'analysis\')?.scrollIntoView({ behavior: \'smooth\' })}          className=\"absolute bottom-12 left-1/2 -translate-x-1/2 text-white flex flex-col items-center gap-2 hover:text-[#7A98B8] transition-colors z-50\"        >          <span className=\"font-sans text-[10px] uppercase tracking-widest font-bold\">Next</span>          <ArrowDown size={20} />        </motion.button>      )}      <div className=\"absolute bottom-12 left-8 md:left-20 z-30 pointer-events-none\">        <h2 className=\"text-[32px] md:text-[40px] font-black tracking-tighter text-white mb-2\">The Journey Begins</h2>        <p className=\"font-sans text-[11px] uppercase tracking-[0.2em] text-[#7A98B8] max-w-md leading-relaxed\">          Starting in the Netherlands, exploring <br className=\"hidden md:block\" />the vast archives of cultural artifacts.        </p>      </div>    </section>  );}"
    }
