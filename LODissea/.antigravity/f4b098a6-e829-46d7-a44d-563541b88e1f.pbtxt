      replacement_content: "import { motion } from \'motion/react\';\n\nexport default function About() {\n  return (\n    <section className=\"relative min-h-screen bg-blue-900 text-blue-50 py-24 px-8 md:px-24 flex flex-col justify-center\">\n      {/* Wave pattern overlay or gradient could be added here */}\n      <div className=\"absolute inset-0 bg-gradient-to-b from-blue-800 to-blue-950 opacity-50 pointer-events-none\" />\n      \n      <div className=\"max-w-4xl mx-auto space-y-24 z-10 relative\">\n        <motion.div\n          id=\"about-project\"\n          initial={{ opacity: 0, y: 20 }}\n          whileInView={{ opacity: 1, y: 0 }}\n          viewport={{ once: true, margin: \"-100px\" }}\n          transition={{ duration: 0.8 }}\n        >\n          <h2 className=\"text-sm font-medium tracking-widest uppercase mb-6 text-blue-300\">The Project</h2>\n          <p className=\"text-2xl md:text-4xl font-serif leading-relaxed text-blue-50\">\n            LODissea maps the cultural connections across Europe, exploring the vast archives of the Europeana database. \n            We navigate through digital artifacts, surfacing hidden narratives and shared histories.\n          </p>\n        </motion.div>\n\n        <motion.div\n          id=\"about-team\"\n          initial={{ opacity: 0, y: 20 }}\n          whileInView={{ opacity: 1, y: 0 }}\n          viewport={{ once: true, margin: \"-100px\" }}\n          transition={{ duration: 0.8, delay: 0.2 }}\n        >\n          <h2 className=\"text-sm font-medium tracking-widest uppercase mb-6 text-blue-300\">The Team</h2>\n          <div className=\"grid md:grid-cols-2 gap-8 text-lg font-light leading-relaxed\">\n            <p>\n              A multidisciplinary group of researchers, designers, and developers passionate about digital cultural heritage and semantic web technologies.\n            </p>\n            <p>\n              Working together to make open data accessible, engaging, and meaningful for everyone navigating the European cultural landscape.\n            </p>\n          </div>\n        </motion.div>\n\n        <motion.div\n          id=\"about-credit\"\n          initial={{ opacity: 0, y: 20 }}\n          whileInView={{ opacity: 1, y: 0 }}\n          viewport={{ once: true, margin: \"-100px\" }}\n          transition={{ duration: 0.8, delay: 0.4 }}\n        >\n          <h2 className=\"text-sm font-medium tracking-widest uppercase mb-6 text-blue-300\">Disclaimer & Credits</h2>\n          <p className=\"text-lg font-light leading-relaxed max-w-2xl text-blue-200\">\n            Data sourced from Europeana. All cultural artifacts remain the property of their respective institutions. \n            This project uses Linked Open Data (LOD) principles to connect and display these resources.\n          </p>\n        </motion.div>\n      </div>\n    </section>\n  );\n}\n"
    }
