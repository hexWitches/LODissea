    replacement_chunks {
      target_content: "import { motion } from \'motion/react\';\nimport { Sailboat } from \'lucide-react\';\nimport Navigation from \'./Navigation\';\n\nexport default function Hero({ onOpenAbout }: { onOpenAbout?: (tab: string) => void }) {\n  const scrollToMap = () => {\n    document.getElementById(\'journey\')?.scrollIntoView({ behavior: \'smooth\' });\n  };\n\n  return (\n    <section id=\"hero\" className=\"relative min-h-screen flex flex-col bg-[#FBF9F5] overflow-hidden\">\n      <Navigation onOpenAbout={onOpenAbout} />\n      \n      <motion.div\n        initial={{ opacity: 0, y: 20 }}\n        animate={{ opacity: 1, y: 0 }}\n        transition={{ duration: 1 }}\n        className=\"pt-24 px-8 md:px-20 z-10 max-w-2xl mt-24\"\n      >\n        <motion.div\n          animate={{ y: [0, -10, 0] }}\n          transition={{ repeat: Infinity, duration: 4, ease: \"easeInOut\" }}\n          className=\"mb-8 text-[#1A3A5F]\"\n          layoutId=\"boat-icon\" \n        >\n          <Sailboat size={48} strokeWidth={1.5} />\n        </motion.div>\n        \n        <h1 className=\"text-[80px] md:text-[110px] leading-[0.85] font-black tracking-tighter mb-6 text-[#1A1A1A]\">\n          LOD<span className=\"italic font-light\">issea</span>\n        </h1>\n        <p className=\"font-sans text-[11px] md:text-[13px] uppercase tracking-[0.3em] text-[#5A5A5A] max-w-md leading-relaxed\">\n          A journey through european(a) <br className=\"hidden md:block\" />cultural heritage database\n        </p>\n      </motion.div>\n\n      {/* Vertical Page Numbers / Status */}\n      <div className=\"absolute left-10 top-1/2 -translate-y-1/2 hidden md:flex flex-col gap-4 items-center\">\n        <div className=\"w-[1px] h-20 bg-gray-300\"></div>\n        <span className=\"text-[10px] font-sans font-bold text-[#1A3A5F] rotate-90 my-2\">01</span>\n        <div className=\"w-[1px] h-20 bg-gray-300\"></div>\n      </div>\n\n      <motion.button\n        initial={{ opacity: 0 }}\n        animate={{ opacity: 1 }}\n        transition={{ delay: 1, duration: 1 }}\n        onClick={scrollToMap}\n        className=\"absolute bottom-12 left-1/2 -translate-x-1/2 text-[#5A5A5A] hover:text-[#1A3A5F] transition-colors uppercase tracking-widest text-xs flex flex-col items-center gap-2\"\n      >\n        <span className=\"font-sans text-[10px] font-bold\">Start the Journey</span>\n        <motion.div\n          animate={{ y: [0, 5, 0] }}\n          transition={{ repeat: Infinity, duration: 2 }}\n          className=\"w-px h-8 bg-current\"\n        />\n      </motion.button>\n    </section>\n  );\n}"
      replacement_content: "import { motion } from \'motion/react\';\nimport { Sailboat } from \'lucide-react\';\nimport Navigation from \'./Navigation\';\n\nexport default function Hero({ onOpenAbout }: { onOpenAbout?: (tab: string) => void }) {\n  const scrollToMap = () => {\n    document.getElementById(\'journey\')?.scrollIntoView({ behavior: \'smooth\' });\n  };\n\n  return (\n    <section id=\"hero\" className=\"relative min-h-screen flex flex-col bg-[#FBF9F5] overflow-hidden\">\n      <Navigation onOpenAbout={onOpenAbout} />\n      \n      <div className=\"flex-1 flex flex-col justify-center items-center relative\">\n        <motion.div\n          initial={{ opacity: 0, y: 20 }}\n          animate={{ opacity: 1, y: 0 }}\n          transition={{ duration: 1 }}\n          className=\"pt-24 px-8 md:px-20 z-10 max-w-2xl mt-12 md:mt-24 text-center flex flex-col items-center\"\n        >\n          <motion.div\n            animate={{ y: [0, -10, 0] }}\n            transition={{ repeat: Infinity, duration: 4, ease: \"easeInOut\" }}\n            className=\"mb-8 text-[#1A3A5F]\"\n            layoutId=\"boat-icon\" \n          >\n            <Sailboat size={48} strokeWidth={1.5} />\n          </motion.div>\n          \n          <h1 className=\"text-[80px] md:text-[110px] leading-[0.85] font-black tracking-tighter mb-6 text-[#1A1A1A]\">\n            LOD<span className=\"italic font-light\">issea</span>\n          </h1>\n          <p className=\"font-sans text-[11px] md:text-[13px] uppercase tracking-[0.3em] text-[#5A5A5A] max-w-md leading-relaxed mx-auto\">\n            A journey through european(a) <br className=\"hidden md:block\" />cultural heritage database\n          </p>\n        </motion.div>\n\n        {/* Vertical Page Numbers / Status */}\n        <div className=\"absolute left-10 top-1/2 -translate-y-1/2 hidden md:flex flex-col gap-4 items-center\">\n          <div className=\"w-[1px] h-20 bg-gray-300\"></div>\n          <span className=\"text-[10px] font-sans font-bold text-[#1A3A5F] rotate-90 my-2\">01</span>\n          <div className=\"w-[1px] h-20 bg-gray-300\"></div>\n        </div>\n      </div>\n\n      {/* Sea Transition Section */}\n      <div className=\"w-full bg-[#1A3A5F] relative h-48 flex flex-col items-center justify-end pb-12 mt-auto\">\n        <div className=\"absolute top-[-39px] left-0 w-full overflow-hidden leading-none z-0\">\n          <svg viewBox=\"0 0 1200 120\" preserveAspectRatio=\"none\" className=\"relative block w-full h-[40px] fill-[#1A3A5F]\">\n            <path d=\"M0,60 C150,110 350,10 500,60 C650,110 850,10 1000,60 C1150,110 1350,10 1500,60 L1500,120 L0,120 Z\"></path>\n          </svg>\n        </div>\n\n        {/* Paper boat on the waves */}\n        <motion.div\n          animate={{ y: [0, -10, 0], rotate: [-15, -5, -15] }}\n          transition={{ repeat: Infinity, duration: 4, ease: \"easeInOut\" }}\n          className=\"absolute top-[-50px] left-[15%] md:left-[25%] w-16 h-16 drop-shadow-2xl z-10\"\n        >\n          <svg viewBox=\"0 0 100 100\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n            <path d=\"M10 65 L50 85 L90 65 L50 55 Z\" fill=\"white\" />\n            <path d=\"M50 20 L50 55 L85 65 Z\" fill=\"#F0F0F0\" />\n            <path d=\"M50 20 L50 55 L15 65 Z\" fill=\"#D1D1D1\" />\n          </svg>\n        </motion.div>\n\n        <button\n          onClick={scrollToMap}\n          className=\"bg-white text-[#1A3A5F] px-8 py-3 rounded-full font-sans font-bold text-[10px] uppercase tracking-widest hover:bg-[#D1E0ED] transition-colors z-10 shadow-xl\"\n        >\n          Start the Journey\n        </button>\n      </div>\n    </section>\n  );\n}"
