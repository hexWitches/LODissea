     className=\"absolute bottom-12 left-1/2 -translate-x-1/2 text-[#5A5A5A] hover:text-[#1A3A5F] transition-colors uppercase tracking-widest text-xs flex flex-col items-center gap-2\"      >        <span className=\"font-sans text-[10px] font-bold\">Start the Journey</span>        <motion.div          animate={{ y: [0, 5, 0] }}          transition={{ repeat: Infinity, duration: 2 }}          className=\"w-px h-8 bg-current\"        />      </motion.button>    </section>  );}"
