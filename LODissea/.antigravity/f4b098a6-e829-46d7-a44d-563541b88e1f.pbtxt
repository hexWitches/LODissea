    instruction: "Update MapJourney to fix styling, zoom in, and add arrow down indicator"
    replacement_infos {
      original_chunk {
        target_content: "import { useEffect, useState, useMemo, useRef } from \'react\';\nimport { motion, useInView } from \'motion/react\';\nimport { Sailboat } from \'lucide-react\';\nimport * as d3 from \'d3-geo\';\nimport * as topojson from \'topojson-client\';\n\nconst HIGHLIGHTED_COUNTRIES = [\'Netherlands\', \'Germany\', \'Spain\', \'Portugal\', \'France\', \'Italy\'];\n\nexport default function MapJourney() {\n  const [geographies, setGeographies] = useState<any[]>([]);\n  const containerRef = useRef(null);\n  const isInView = useInView(containerRef, { once: true, margin: \"-20%\" });\n  \n  const [coloredCount, setColoredCount] = useState(0);\n  const [boatPhase, setBoatPhase] = useState<\'hidden\' | \'falling\' | \'onMap\' | \'toLeft\'>(\'hidden\');\n\n  useEffect(() => {\n    fetch(\'https://unpkg.com/world-atlas@2.0.2/countries-50m.json\')\n      .then(response => response.json())\n      .then(topology => {\n        const geo = topojson.feature(topology, topology.objects.countries) as any;\n        setGeographies(geo.features);\n      });\n  }, []);\n\n  useEffect(() => {\n    if (isInView) {\n      setBoatPhase(\'falling\');\n      const t1 = setTimeout(() => setBoatPhase(\'onMap\'), 1500);\n      \n      const intervals = HIGHLIGHTED_COUNTRIES.map((_, i) => {\n        return setTimeout(() => setColoredCount(i + 1), 1500 + i * 500);\n      });\n\n      const t2 = setTimeout(() => setBoatPhase(\'toLeft\'), 1500 + HIGHLIGHTED_COUNTRIES.length * 500 + 500);\n\n      return () => {\n        clearTimeout(t1);\n        clearTimeout(t2);\n        intervals.forEach(clearTimeout);\n      };\n    }\n  }, [isInView]);\n\n  const projection = useMemo(() => {\n    return d3.geoConicConformal()\n      .center([10, 50])\n      .rotate([-10, 0])\n      .scale(900)\n      .translate([400, 300]);\n  }, []);\n\n  const pathGenerator = d3.geoPath().projection(projection);\n  const nlCoords = projection([5.29, 52.13]) || [0, 0];\n\n  return (\n    <section ref={containerRef} id=\"journey\" className=\"relative min-h-screen bg-[#1A3A5F] overflow-hidden flex items-center justify-center\">\n      <div className=\"absolute inset-0 w-full h-full flex items-center justify-center\">\n        <svg\n          viewBox=\"0 0 800 600\"\n          className=\"w-full h-full max-h-screen object-contain\"\n        >\n          <g className=\"countries\">\n            {geographies.map((d, i) => {\n              const name = d.properties?.name;\n              const countryIndex = HIGHLIGHTED_COUNTRIES.indexOf(name);\n              const isHighlighted = countryIndex !== -1 && countryIndex < coloredCount;\n              \n              return (\n                <path\n                  key={`path-${i}`}\n                  d={pathGenerator(d) || undefined}\n                  className={`\n                    transition-all duration-500\n                    ${isHighlighted ? \'fill-[#6D213C] stroke-[#1A3A5F] stroke-[1px] opacity-100\' : \'fill-[#2A4A7F] stroke-[#1A3A5F] stroke-[0.5px] opacity-50\'}\n                  `}\n                />\n              );\n            })}\n          </g>\n\n          {/* Animated Boat Drop Inside SVG */}\n          {boatPhase !== \'hidden\' && boatPhase !== \'toLeft\' && (\n            <motion.g\n              initial={{ y: -400, opacity: 0, scale: 0.5 }}\n              animate={{ y: nlCoords[1] - 40, x: nlCoords[0] - 16, opacity: 1, scale: 1 }}\n              transition={{ duration: 1.5, ease: \"easeOut\" }}\n            >\n              <motion.g\n                animate={{ y: [0, -5, 0], rotate: [-5, 5, -5] }}\n                transition={{ repeat: Infinity, duration: 3, ease: \"easeInOut\" }}\n                style={{ transformOrigin: \"16px 32px\" }}\n              >\n                <foreignObject x=\"0\" y=\"0\" width=\"32\" height=\"32\">\n                  <div className=\"w-full h-full flex items-center justify-center\">\n                    <Sailboat size={32} strokeWidth={2} className=\"fill-[#1A3A5F] text-[#FBF9F5]\" />\n                  </div>\n                </foreignObject>\n              </motion.g>\n            </motion.g>\n          )}\n        </svg>\n      </div>\n      \n      {/* Absolute boat that moves to the left of the screen */}\n      {boatPhase === \'toLeft\' && (\n        <motion.div\n          initial={{ top: \'50%\', left: \'50%\', x: \'-50%\', y: \'-50%\', position: \'absolute\' }}\n          animate={{ left: \'40px\', top: \'80%\', x: 0, y: \'-50%\' }}\n          transition={{ duration: 1, ease: \'easeInOut\' }}\n          className=\"absolute z-50 text-[#FBF9F5] flex flex-col items-center pointer-events-none\"\n        >\n          <motion.div\n            animate={{ y: [0, -5, 0], rotate: [-5, 5, -5] }}\n            transition={{ repeat: Infinity, duration: 3, ease: \"easeInOut\" }}\n            className=\"z-10\"\n          >\n            <Sailboat size={32} strokeWidth={2} className=\"fill-[#FBF9F5] text-[#1A3A5F]\" />\n          </motion.div>\n        </motion.div>\n      )}\n\n      <div className=\"absolute bottom-12 left-8 md:left-20 z-30 pointer-events-none\">\n        <h2 className=\"text-[32px] md:text-[40px] font-black tracking-tighter text-white mb-2\">The Journey Begins</h2>\n        <p className=\"font-sans text-[11px] uppercase tracking-[0.2em] text-[#7A98B8] max-w-md leading-relaxed\">\n          Starting in the Netherlands, exploring <br className=\"hidden md:block\" />the vast archives of cultural artifacts.\n        </p>\n      </div>\n    </section>\n  );\n}"
        replacement_content: "import { useEffect, useState, useMemo, useRef } from \'react\';\nimport { motion, useInView } from \'motion/react\';\nimport { Sailboat, ArrowDown } from \'lucide-react\';\nimport * as d3 from \'d3-geo\';\nimport * as topojson from \'topojson-client\';\n\nconst HIGHLIGHTED_COUNTRIES = [\'Netherlands\', \'Germany\', \'Spain\', \'Portugal\', \'France\', \'Italy\'];\nconst OMITTED_COUNTRIES = [\n  \'Morocco\', \'Algeria\', \'Tunisia\', \'Libya\', \'Egypt\', \'Western Sahara\', \'Mauritania\', \'Mali\', \'Niger\', \'Chad\', \'Sudan\',\n  \'Syria\', \'Iraq\', \'Saudi Arabia\', \'Lebanon\', \'Israel\', \'Jordan\', \'Iran\', \'Kuwait\', \'Georgia\', \'Armenia\', \'Azerbaijan\'\n];\n\nexport default function MapJourney() {\n  const [geographies, setGeographies] = useState<any[]>([]);\n  const containerRef = useRef(null);\n  const isInView = useInView(containerRef, { once: true, margin: \"-20%\" });\n  \n  const [coloredCount, setColoredCount] = useState(0);\n  const [boatPhase, setBoatPhase] = useState<\'hidden\' | \'falling\' | \'onMap\' | \'toLeft\'>(\'hidden\');\n\n  useEffect(() => {\n    fetch(\'https://unpkg.com/world-atlas@2.0.2/countries-50m.json\')\n      .then(response => response.json())\n      .then(topology => {\n        const geo = topojson.feature(topology, topology.objects.countries) as any;\n        setGeographies(geo.features);\n      });\n  }, []);\n\n  useEffect(() => {\n    if (isInView) {\n      setBoatPhase(\'falling\');\n      const t1 = setTimeout(() => setBoatPhase(\'onMap\'), 1500);\n      \n      const intervals = HIGHLIGHTED_COUNTRIES.map((_, i) => {\n        return setTimeout(() => setColoredCount(i + 1), 1500 + i * 500);\n      });\n\n      const t2 = setTimeout(() => setBoatPhase(\'toLeft\'), 1500 + HIGHLIGHTED_COUNTRIES.length * 500 + 500);\n\n      return () => {\n        clearTimeout(t1);\n        clearTimeout(t2);\n        intervals.forEach(clearTimeout);\n      };\n    }\n  }, [isInView]);\n\n  const projection = useMemo(() => {\n    return d3.geoConicConformal()\n      .center([15, 52])\n      .rotate([-10, 0])\n      .scale(1600)\n      .translate([400, 300]);\n  }, []);\n\n  const pathGenerator = d3.geoPath().projection(projection);\n  const nlCoords = projection([5.29, 52.13]) || [0, 0];\n\n  return (\n    <section ref={containerRef} id=\"journey\" className=\"relative h-screen bg-[#1A3A5F] overflow-hidden flex items-center justify-center pt-24\">\n      <div className=\"absolute inset-0 w-full h-full flex items-center justify-center\">\n        <svg\n          viewBox=\"0 0 800 600\"\n          className=\"w-full h-full max-h-[90vh] object-contain\"\n        >\n          <g className=\"countries\">\n            {geographies.map((d, i) => {\n              const name = d.properties?.name;\n              if (OMITTED_COUNTRIES.includes(name)) return null;\n\n              const countryIndex = HIGHLIGHTED_COUNTRIES.indexOf(name);\n              const isHighlighted = countryIndex !== -1 && countryIndex < coloredCount;\n              \n              return (\n                <path\n                  key={`path-${i}`}\n                  d={pathGenerator(d) || undefined}\n                  className={`\n                    transition-all duration-500\n                    ${isHighlighted ? \'fill-[#6D213C] stroke-[#1A3A5F] stroke-[1px] opacity-100\' : \'fill-[#FBF9F5] stroke-[#1A3A5F] stroke-[0.5px] opacity-100\'}\n                  `}\n                />\n              );\n            })}\n          </g>\n\n          {/* Animated Boat Drop Inside SVG */}\n          {boatPhase !== \'hidden\' && boatPhase !== \'toLeft\' && (\n            <motion.g\n              initial={{ y: -400, opacity: 0, scale: 0.5 }}\n              animate={{ y: nlCoords[1] - 40, x: nlCoords[0] - 16, opacity: 1, scale: 1 }}\n              transition={{ duration: 1.5, ease: \"easeOut\" }}\n            >\n              <motion.g\n                animate={{ y: [0, -5, 0], rotate: [-5, 5, -5] }}\n                transition={{ repeat: Infinity, duration: 3, ease: \"easeInOut\" }}\n                style={{ transformOrigin: \"16px 32px\" }}\n              >\n                <foreignObject x=\"0\" y=\"0\" width=\"32\" height=\"32\">\n                  <div className=\"w-full h-full flex items-center justify-center\">\n                    <Sailboat size={32} strokeWidth={2} className=\"fill-[#1A3A5F] text-[#FBF9F5]\" />\n                  </div>\n                </foreignObject>\n              </motion.g>\n            </motion.g>\n          )}\n        </svg>\n      </div>\n      \n      {/* Absolute boat that moves to the left of the screen */}\n      {boatPhase === \'toLeft\' && (\n        <motion.div\n          initial={{ top: \'50%\', left: \'50%\', x: \'-50%\', y: \'-50%\', position: \'absolute\' }}\n          animate={{ left: \'40px\', top: \'80%\', x: 0, y: \'-50%\' }}\n          transition={{ duration: 1, ease: \'easeInOut\' }}\n          className=\"absolute z-50 text-[#FBF9F5] flex items-center gap-4 pointer-events-none\"\n        >\n          <motion.div\n            animate={{ y: [0, -5, 0], rotate: [-5, 5, -5] }}\n            transition={{ repeat: Infinity, duration: 3, ease: \"easeInOut\" }}\n            className=\"z-10\"\n          >\n            <Sailboat size={32} strokeWidth={2} className=\"fill-[#FBF9F5] text-[#1A3A5F]\" />\n          </motion.div>\n          <motion.span \n            initial={{ opacity: 0 }}\n            animate={{ opacity: 1 }}\n            transition={{ delay: 0.5 }}\n            className=\"font-sans text-[10px] font-bold tracking-widest uppercase text-[#7A98B8]\"\n          >\n            QQ1\n          </motion.span>\n        </motion.div>\n      )}\n\n      {boatPhase === \'toLeft\' && (\n        <motion.button\n          initial={{ opacity: 0, y: -20 }}\n          animate={{ opacity: 1, y: 0 }}\n          transition={{ delay: 1 }}\n          onClick={() => document.getElementById(\'analysis\')?.scrollIntoView({ behavior: \'smooth\' })}\n          className=\"absolute bottom-12 left-1/2 -translate-x-1/2 text-white flex flex-col items-center gap-2 hover:text-[#7A98B8] transition-colors z-50\"\n        >\n          <span className=\"font-sans text-[10px] uppercase tracking-widest font-bold\">Next</span>\n          <ArrowDown size={20} />\n        </motion.button>\n      )}\n\n      <div className=\"absolute bottom-12 left-8 md:left-20 z-30 pointer-events-none\">\n        <h2 className=\"text-[32px] md:text-[40px] font-black tracking-tighter text-white mb-2\">The Journey Begins</h2>\n        <p className=\"font-sans text-[11px] uppercase tracking-[0.2em] text-[#7A98B8] max-w-md leading-relaxed\">\n          Starting in the Netherlands, exploring <br className=\"hidden md:block\" />the vast archives of cultural artifacts.\n        </p>\n      </div>\n    </section>\n  );\n}"
      }
